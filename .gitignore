node_modules/
.env*
!.env.example
**/*.log
projects/*/assets/photos/
__pycache__/
library/sfx/raw/
projects/*/out/
projects/*/audio/source.*
projects/*/audio/*.wav
*.tmp
voice-clone/
projects/*/audio/*.mp3
projects/*/audio/_tts/

# shorts from long videos: source media stays local, never pushed (public repo)
shorts/*/source/
shorts/*/clips/
# footage shorts: face frames are extracted from the source video, never pushed
projects/*/assets/face/
shorts/*/photos/
# Codex generation logs carry local paths; unused Codex candidates stay local
projects/*/assets/codex/**/*.log
# long-video transcripts (whole video, not just the short) and check frames stay local
shorts/*/transcript.*
shorts/*/work/*.png
shorts/*/work/*.jpg
.pytest_cache/
tests/.tmp*/
